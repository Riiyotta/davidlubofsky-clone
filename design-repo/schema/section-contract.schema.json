{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "section-contract.schema.json",
  "title": "Section contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "source", "semantic", "retrievalEligible", "variants", "content", "styleSlots", "assetRoles", "generatedAssetRoles", "constraints", "motion", "responsive", "uses", "templates"],
  "properties": {
    "id": { "type": "string", "pattern": "^(shell|utility|hero|content|conversion|media|layout|navigation)\\.[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 20 },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["id", "file", "lines", "tag"],
      "properties": {
        "id": { "type": "string", "pattern": "^src:" },
        "file": { "type": "string", "pattern": "^src/" },
        "lines": { "type": "string", "pattern": "^[0-9]+(-[0-9]+)?$" },
        "tag": { "type": "string", "minLength": 3 }
      }
    },
    "semantic": {
      "type": "object", "additionalProperties": false, "required": ["id", "category"],
      "properties": {
        "id": { "type": "string" },
        "category": { "enum": ["SHELL", "UTILITY", "HERO", "INDEX", "CONTENT", "CONVERSION", "MEDIA", "LAYOUT", "NAVIGATION"] }
      }
    },
    "retrievalEligible": { "type": "boolean" },
    "retrievalReason": { "type": "string", "minLength": 30 },
    "variants": { "type": "array", "items": { "type": "string", "pattern": "^[a-z-]+$" } },
    "content": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["kind"],
        "properties": {
          "kind": { "enum": ["text", "rich", "link", "links", "href", "words", "asset", "assets"] },
          "maxWords": { "type": "integer", "minimum": 1 },
          "labelMaxWords": { "type": "integer", "minimum": 1 },
          "maxParagraphs": { "type": "integer", "minimum": 1 },
          "min": { "type": "integer", "minimum": 0 },
          "max": { "type": "integer", "minimum": 1 },
          "optional": { "type": "boolean" },
          "evidenceLiterals": { "type": "integer" },
          "roles": { "type": "array", "items": { "type": "string" } },
          "generatedRoles": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "styleSlots": {
      "type": "object",
      "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["tokenFamily", "required"], "properties": { "tokenFamily": { "type": "string" }, "required": { "type": "boolean" } } }
    },
    "assetRoles": { "type": "array", "items": { "type": "string" } },
    "generatedAssetRoles": { "type": "array", "items": { "type": "string" } },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "properties": { "onePerPage": { "type": "boolean" }, "maxPerPage": { "type": "integer" }, "minPerPage": { "type": "integer" }, "mustBeFirst": { "type": "boolean" }, "mustBeLast": { "type": "boolean" } }
    },
    "motion": {
      "type": "object", "additionalProperties": false, "required": ["allowed", "default", "reducedMotionFallback"],
      "properties": {
        "allowed": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "default": { "type": "string" },
        "reducedMotionFallback": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "responsive": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["at", "change", "detail", "evidence", "evidenceTag"],
        "properties": {
          "at": { "enum": ["bp.s", "bp.m", "bp.l", "bp.xl", "bp.hover"] },
          "change": { "enum": ["stack-to-row", "hide-to-show", "font-size-step", "layout-shift", "size-step", "gutter-step", "height-step", "slides-per-view", "interaction-swap"] },
          "detail": { "type": "string", "minLength": 10 },
          "evidence": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+:[0-9]+(-[0-9]+)?$" },
          "evidenceTag": { "type": "string" }
        }
      }
    },
    "uses": {
      "type": "object", "additionalProperties": false, "required": ["primitives", "components", "tokens"],
      "properties": { "primitives": { "type": "array", "items": { "type": "string" } }, "components": { "type": "array", "items": { "type": "string" } }, "tokens": { "type": "array", "items": { "type": "string" } } }
    },
    "templates": { "type": "array", "minItems": 1, "items": { "enum": ["template.home", "template.case-study"] } }
  },
  "allOf": [
    { "if": { "properties": { "retrievalEligible": { "const": false } } }, "then": { "required": ["retrievalReason"] } }
  ]
}
