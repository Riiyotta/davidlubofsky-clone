  "properties": {
    "pageSpecVersion": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": [
        "reference",
        "generated"
      ],
      "description": "reference = faithful reconstruction of the source; generated = new page that must contain no source identity, copy, URLs or assets."
