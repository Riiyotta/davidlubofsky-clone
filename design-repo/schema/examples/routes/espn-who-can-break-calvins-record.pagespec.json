          "role": "case.screenshot",
          "src": "/images/1694793095-screens.jpg"
        }
      },
      "motion": {
        "pattern": "image-fade-in",
        "reducedMotionFallback": "instant-visible"
      }
    },
    {
      "section": "content.text",
      "variant": "statement",
      "content": {
        "text": [
          {
            "text": "The result? A sports story of legends.",
            "highlights": [
