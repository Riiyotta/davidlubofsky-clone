        "highlight": "break",
        "rolesLabel": "Roles",
        "roles": "Technology",
        "description": "Leveraging scroll + animation to tell a colorful story about a legendary player",
        "featuredImage": {
          "role": "case.featured-image",
          "src": "/images/1694799124-hero-for-book2.jpg"
        }
      },
      "style": {
