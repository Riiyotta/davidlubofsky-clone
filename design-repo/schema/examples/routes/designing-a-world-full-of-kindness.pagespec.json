        "title": "Kindness, as part of the experience",
        "body": [
          {
            "text": "BK is a studio that believes digital experiences should feel human, so their website should bring that thinking to life through thoughtful design, clever technology, and unexpected moments of delight."
          }
        ],
        "image": {
          "role": "case.screenshot",
          "src": "/images/1793617022-framed-bk.jpg"
        },
        "highlight": "Kindness",
        "cta": {
          "label": "View the project",
