        "pattern": "line-reveal",
        "reducedMotionFallback": "instant-visible"
      }
    },
    {
      "section": "content.media-text",
      "content": {
        "title": "Creating a feeling from only seeing",
        "body": [
          {
            "text": "We used Three.js and GSAP to distort everyday scenes and show how eight different eye conditions change what a person sees. And what they feel"
          }
        ],
        "image": {
          "role": "case.screenshot",
          "src": "/images/1793385258-intro-frame.jpg"
        },
        "highlight": "only",
        "cta": {
          "label": "View the project",
          "href": "https://www.seewhateyesee.org/"
        }
      },
      "motion": {
        "pattern": "image-fade-in",
        "reducedMotionFallback": "instant-visible"
      }
    },
    {
      "section": "media.video",
      "content": {
        "video": {
          "role": "case.video",
          "src": "/videos/1241669602.mp4"
        }
