        "title": "A browser-bending look at vision loss",
        "highlight": "bending",
        "rolesLabel": "Roles",
        "roles": "Creative; Technology",
        "description": "An interactive simulator that shows what life looks like for people living with eye conditions.",
        "featuredImage": {
          "role": "case.featured-image",
          "src": "/images/1793379946-dl-hero.jpg"
        }
      },
      "style": {
        "accent": "color.accent.rose"
      },
