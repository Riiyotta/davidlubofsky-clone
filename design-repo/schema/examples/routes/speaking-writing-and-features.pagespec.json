        "body": [
          {
            "text": "awwwards case study",
            "highlights": [
              "case study"
            ]
          },
          {
            "text": "This case study from awwwards with myself, Bryan James, and Jesper Landberg takes a deep look into our approach and process to building a smile-filled, animated web version of a heavily-illustrated book."
          }
        ],
        "image": {
          "role": "case.screenshot",
