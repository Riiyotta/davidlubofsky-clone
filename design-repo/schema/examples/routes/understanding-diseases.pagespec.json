        "title": "Content is not one size fits all",
        "body": [
          {
            "text": "As part of a partnership with some amazing humans, we built a ground-breaking web-based platform that offers disease education content at multiple levels of understanding."
          }
        ],
        "image": {
          "role": "case.screenshot",
          "src": "/images/1674905999-udphones.jpg"
